diff --git a/rpcs3/Emu/Memory/vm.cpp b/rpcs3/Emu/Memory/vm.cpp
index ae7e3dd70..edcf9cbb9 100644
--- a/rpcs3/Emu/Memory/vm.cpp
+++ b/rpcs3/Emu/Memory/vm.cpp
@@ -1174,9 +1174,20 @@ namespace vm
 		ensure(addr % 4096 == 0);
 		ensure(size % 4096 == 0);
 
+		// GT6 build: once locking failed (RLIMIT_MEMLOCK too small, no root to change it),
+		// stop retrying - every attempt is a failing syscall plus an error log line on a game
+		// thread (~1900 times in GT6's first two minutes). Memory works fine unlocked.
+		static atomic_t<bool> s_lock_unavailable = false;
+
+		if (s_lock_unavailable)
+		{
+			return;
+		}
+
 		if (!utils::memory_lock(g_sudo_addr + addr, size))
 		{
-			vm_log.error("Failed to lock sudo memory (addr=0x%x, size=0x%x). Consider increasing your system limits.", addr, size);
+			s_lock_unavailable = true;
+			vm_log.warning("Memory locking unavailable (system limit); continuing without it (addr=0x%x, size=0x%x).", addr, size);
 		}
 	}
 
