+	// GT6 build: RPCS3_USERCMD_MODE=upstream restores the upstream USER_COMMAND stall/drain, anything else = legacy.
+	bool usercmd_legacy_mode()
+	{
+		static const bool legacy = []
+		{
+			const char* v = ::getenv("RPCS3_USERCMD_MODE");
+			return !(v && std::string_view(v) == "upstream");
+		}();
+		return legacy;
+	}
