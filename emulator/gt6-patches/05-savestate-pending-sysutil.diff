+extern atomic_t<bool> g_netstart_pending;
+
+extern bool check_if_sysutil_callbacks_pending()
+{
+	// Registered but not yet dispatched callbacks are not serialized (sysutil_cb_manager::save)
+	// ponytail: a PPU HLE call can still queue one in the few ms before it pauses (GT6 trophy setup ~8-10 s after
+	// boot) and hit that ensure; closing it needs serializable callbacks or blocking registration while saving.
+	const auto cbm = g_fxo->try_get<sysutil_cb_manager>();
+	return g_netstart_pending || (cbm && static_cast<bool>(cbm->registered));
+}
+
 void sysutil_register_cb_with_id_internal(std::function<s32(ppu_thread&)>&& cb, usz call_id)
